<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dunkle Palette: gedämpfte Flächen, kein reines Schwarz, Signalfarben mit genug Kontrast. -->
    <Color x:Key="App.AccentColor">#7AA2FF</Color>
    <SolidColorBrush x:Key="App.Background" Color="#16181C" />
    <SolidColorBrush x:Key="App.Surface" Color="#1F2227" />
    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#262A30" />
    <SolidColorBrush x:Key="App.Border" Color="#343941" />
    <SolidColorBrush x:Key="App.Text" Color="#E6E8EB" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="#A0A7B1" />
    <SolidColorBrush x:Key="App.Accent" Color="#7AA2FF" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#26324D" />
    <SolidColorBrush x:Key="App.OnAccent" Color="#0E1320" />
    <SolidColorBrush x:Key="App.Positive" Color="#3DD68C" />
    <SolidColorBrush x:Key="App.Negative" Color="#FF6B6B" />
    <SolidColorBrush x:Key="App.Warning" Color="#FFC764" />
    <SolidColorBrush x:Key="App.WarningBackground" Color="#3A2E14" />
    <SolidColorBrush x:Key="App.WarningBorder" Color="#7A5A1C" />
    <SolidColorBrush x:Key="App.Info" Color="#9DB8FF" />
    <SolidColorBrush x:Key="App.InfoBackground" Color="#1E2A44" />
    <SolidColorBrush x:Key="App.Danger" Color="#E53935" />
    <SolidColorBrush x:Key="App.DangerHover" Color="#FF5249" />
    <SolidColorBrush x:Key="App.DangerBackground" Color="#3B1C1C" />
    <SolidColorBrush x:Key="App.OnDanger" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.NavBackground" Color="#1A1D21" />
    <SolidColorBrush x:Key="App.NavHover" Color="#262A30" />
    <SolidColorBrush x:Key="App.NavSelected" Color="#2C3139" />
</ResourceDictionary>
