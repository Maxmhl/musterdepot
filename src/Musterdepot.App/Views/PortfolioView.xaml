<UserControl x:Class="Musterdepot.App.Views.PortfolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Musterdepot.App.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PortfolioViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="180" />
            <RowDefinition Height="16" />
            <RowDefinition Height="3*" MinHeight="200" />
        </Grid.RowDefinitions>

        <!-- Kennzahlen-Kacheln -->
        <UniformGrid Rows="1" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Equity" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Equity}" Style="{StaticResource KpiValue}" />
                    <TextBlock Text="{Binding AsOf}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="Cash (verfügbar)" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Cash}" Style="{StaticResource KpiValue}" />
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="verfügbar" /> <Run Text="{Binding AvailableCash, Mode=OneWay}" />
                        <Run Text="· reserviert" /> <Run Text="{Binding ReservedCash, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="Tages-GuV" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DayPnl}" Tag="{Binding DayPnlSign}" Style="{StaticResource SignedKpi}" />
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="Positionen" /> <Run Text="{Binding PositionsValue, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="GuV offen" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding UnrealizedPnl}" Tag="{Binding UnrealizedSign}" Style="{StaticResource SignedKpi}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Bewertung zum letzten Kurs" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="GuV realisiert" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding RealizedPnl}" Tag="{Binding RealizedSign}" Style="{StaticResource SignedKpi}" />
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="Gebühren" /> <Run Text="{Binding FeesPaid, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,12"
                    Visibility="{Binding HasDelayedPrices, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource App.Warning}"
                           Text="Einige Positionen sind mit verzögerten Aktienkursen (15–30 Min) bewertet – Equity und GuV sind dort nicht aktuell." />
            </Border>
        </StackPanel>

        <!-- Positionen -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Positionen" Style="{StaticResource SectionTitle}" Margin="16,12,16,4" />
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedPosition}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="140" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="100" />
                        <DataGridTextColumn Header="Ø Einstand" Binding="{Binding AverageCost}" Width="110" />
                        <DataGridTemplateColumn Header="Kurs" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:PositionRowViewModel}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding PriceAsOf}">
                                        <TextBlock Text="{Binding LastPrice}" />
                                        <Border Style="{StaticResource DelayedBadge}" Margin="6,0,0,0"
                                                Visibility="{Binding IsDelayed, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="verzögert" Style="{StaticResource DelayedBadgeText}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Marktwert" Binding="{Binding MarketValue}" Width="120" />
                        <DataGridTextColumn Header="Einstand ges." Binding="{Binding CostBasis}" Width="120" />
                        <DataGridTemplateColumn Header="GuV offen" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:PositionRowViewModel}">
                                    <TextBlock Tag="{Binding UnrealizedSign}" Style="{StaticResource SignedText}">
                                        <Run Text="{Binding Unrealized, Mode=OneWay}" /> <Run Text="{Binding UnrealizedPercent, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="GuV realisiert" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:PositionRowViewModel}">
                                    <TextBlock Text="{Binding Realized}" Tag="{Binding RealizedSign}" Style="{StaticResource SignedText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:PositionRowViewModel}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource LinkButton}" Content="Chart"
                                                Command="{Binding DataContext.OpenChartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource LinkButton}" Content="Handeln"
                                                Command="{Binding DataContext.TradeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Equity-Kurve und Kennzahlen -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Equity-Kurve" Style="{StaticResource SectionTitle}" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Text="Diagramm: ScottPlot (MIT)" HorizontalAlignment="Right" />
                    <sp:WpfPlot x:Name="EquityPlot" />
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Kennzahlen" Style="{StaticResource SectionTitle}" />
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SelectedSourceFilter}" DisplayMemberPath="Label"
                                  ToolTip="Nur Trades von Mensch oder KI" />
                        <TextBox Grid.Column="2" Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Strategie-Tag (leer = alle)" />
                        <Button Grid.Column="3" Content="Anwenden" Margin="8,0,0,0" Command="{Binding RefreshStatsCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatItem}">
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Tag="{Binding Sign}" Style="{StaticResource SignedText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
