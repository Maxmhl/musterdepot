<UserControl x:Class="Musterdepot.App.Views.AiActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Musterdepot.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AiActivityViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Not-Aus -->
        <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Großer roter Knopf zum Auslösen -->
                <Button Style="{StaticResource KillSwitchButton}" Command="{Binding EngageKillSwitchCommand}"
                        Visibility="{Binding KillSwitchEngaged, Converter={StaticResource InverseBoolToVis}}"
                        ToolTip="Storniert alle offenen Orders und sperrt neue Orders – für Mensch und KI.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="NOT-AUS" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Ausgelöst: Lösen nur hier per Klick -->
                <Border Style="{StaticResource DangerBanner}" Padding="20,14"
                        Visibility="{Binding KillSwitchEngaged, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="NOT-AUS AKTIV" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource App.Danger}" />
                        <Button Content="Not-Aus lösen …" Style="{StaticResource DangerButton}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Command="{Binding ReleaseKillSwitchCommand}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Not-Aus" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="13">
                        <Run Text="Storniert sofort alle offenen Orders und lehnt neue Orders ab – egal ob von Ihnen oder einer KI." />
                        <LineBreak />
                        <Run Text="Eine KI darf den Not-Aus auslösen, lösen kann ihn nur ein Mensch hier im Programm. Auch im Infobereich-Menü verfügbar." />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Protokoll -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,12,16,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Protokoll aller Aktionen" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="200" Text="{Binding ClientFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="Filter: Client oder Aktion" />
                        <CheckBox Content="nur KI" IsChecked="{Binding OnlyAi}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="CSV (Excel DE)" Command="{Binding ExportAuditCommand}" CommandParameter="de" Margin="0,0,6,0" />
                        <Button Content="CSV (international)" Command="{Binding ExportAuditCommand}" CommandParameter="invariant" />
                    </StackPanel>
                </Grid>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="16,8"
                        Visibility="{Binding SelectedAudit, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="Parameter" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding SelectedAudit.Parameters, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                            <Run Text="Meldung:" /> <Run Text="{Binding SelectedAudit.Message, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding AuditEntries}" SelectedItem="{Binding SelectedAudit}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="110" />
                        <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="70" />
                        <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="120" />
                        <DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="160" FontWeight="SemiBold" />
                        <DataGridTemplateColumn Header="Ergebnis" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:AuditRowViewModel}">
                                    <TextBlock x:Name="R" Text="{Binding Result}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                            <Setter TargetName="R" Property="Foreground" Value="{DynamicResource App.Negative}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Freigegeben von" Binding="{Binding ApprovedBy}" Width="110" />
                        <DataGridTextColumn Header="Dauer" Binding="{Binding Duration}" Width="70" />
                        <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Rechte Spalte: Freigaben und Clients -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Freigabe-Warteschlange" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Keine offenen Anfragen. KI-Clients im Modus „confirm“ landen hier." Style="{StaticResource Caption}"
                                   Visibility="{Binding PendingApprovals.Count, Converter={StaticResource PositiveToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding PendingApprovals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ApprovalItemViewModel}">
                                    <Border BorderBrush="{DynamicResource App.WarningBorder}" Background="{DynamicResource App.WarningBackground}"
                                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding Created, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding ClientName, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="·" />
                                                <Run Text="{Binding CommandName, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,4,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Erlauben" Style="{StaticResource PositiveButton}" Command="{Binding ApproveCommand}" Margin="0,0,8,0" />
                                                <Button Content="Ablehnen" Style="{StaticResource DangerButton}" Command="{Binding DenyCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Aktualisieren" Command="{Binding RefreshAgentsCommand}" />
                            <TextBlock Text="KI-Clients" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Noch kein KI-Client angelegt – Token unter „Einstellungen“ erzeugen."
                                   Visibility="{Binding Agents.Count, Converter={StaticResource PositiveToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AgentStatusItem}">
                                    <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource DelayedBadge}"
                                                        Visibility="{Binding Blocked, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding BlockReason}" Style="{StaticResource DelayedBadgeText}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Mode}" Style="{StaticResource Caption}" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="Rechte:" /> <Run Text="{Binding Scopes, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="Orders:" /> <Run Text="{Binding Orders, Mode=OneWay}" />
                                                <Run Text="· offene Freigaben:" /> <Run Text="{Binding Approvals, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="Zuletzt aktiv:" /> <Run Text="{Binding LastActivity, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
    </Grid>
</UserControl>
