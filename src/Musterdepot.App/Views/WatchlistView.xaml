<UserControl x:Class="Musterdepot.App.Views.WatchlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Musterdepot.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WatchlistViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Risiko-Hinweis verzögerte Aktien -->
        <Border Grid.ColumnSpan="3" Style="{StaticResource WarningBanner}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource App.Warning}"
                           FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource App.Warning}" MaxWidth="1100">
                    <Run FontWeight="SemiBold" Text="Aktienkurse sind 15–30 Minuten verzögert." />
                    <Run Text="Ohne Anmeldung gibt es keine Echtzeit-Aktienkurse (Quelle gettex). Orders auf Aktien werden erst gegen Kurse nach dem Ordereingang simuliert (Fill-Qualität SYNTHETIC, angenommener Spread) – Ergebnisse können deutlich vom echten Handel abweichen. Krypto läuft in Echtzeit." />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Kurstabelle -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Width="220" ItemsSource="{Binding Watchlists}" SelectedItem="{Binding SelectedWatchlist}"
                              DisplayMemberPath="Name" ToolTip="Watchlist wählen" />
                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Caption}"
                               Text="Keine Watchlist – es werden alle bekannten Kurse angezeigt."
                               Visibility="{Binding ShowsAllQuotes, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Ausgewählte entfernen" Command="{Binding RemoveSymbolCommand}"
                                CommandParameter="{Binding SelectedRow}" Margin="0,0,8,0" />
                        <Button Content="Watchlist löschen" Command="{Binding DeleteWatchlistCommand}" />
                    </StackPanel>
                </Grid>
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenChartCommand}" CommandParameter="{Binding SelectedRow}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="150" FontWeight="SemiBold" />
                        <DataGridTemplateColumn Header="Letzter" Width="120" SortMemberPath="Last">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:QuoteRowViewModel}">
                                    <TextBlock Text="{Binding Last}" HorizontalAlignment="Right" FontWeight="SemiBold" ToolTip="{Binding ToolTip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Änderung" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:QuoteRowViewModel}">
                                    <TextBlock Text="{Binding Change}" Tag="{Binding ChangeSign}" Style="{StaticResource SignedText}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Geld" Binding="{Binding Bid}" Width="100" />
                        <DataGridTextColumn Header="Brief" Binding="{Binding Ask}" Width="100" />
                        <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="90" />
                        <DataGridTemplateColumn Header="Datenstand" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:QuoteRowViewModel}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                        <TextBlock Text="{Binding AsOf}" />
                                        <TextBlock Text="{Binding Age}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Hinweis" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:QuoteRowViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource DelayedBadge}" ToolTip="{Binding ToolTip}"
                                                Visibility="{Binding IsDelayed, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource DelayedBadgeText}">
                                                <Run Text="&#x23F1; " /><Run Text="{Binding DelayBadge, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="kein Kurs" Style="{StaticResource Caption}"
                                                   Visibility="{Binding HasQuote, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:QuoteRowViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource LinkButton}" Content="Chart"
                                                Command="{Binding DataContext.OpenChartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource LinkButton}" Content="Handeln"
                                                Command="{Binding DataContext.TradeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Rechte Spalte: Suche und Watchlists verwalten -->
        <StackPanel Grid.Row="1" Grid.Column="2">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Symbol suchen" Style="{StaticResource SectionTitle}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="z. B. BTC, ETH/EUR, SAP oder ISIN DE0007164600" />
                    <TextBlock Text="Krypto (Kraken, Bitvavo) oder Aktie (Name, ISIN)" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0"
                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />
                    <ListBox ItemsSource="{Binding SearchResults}" MaxHeight="320" Margin="0,8,0,0" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchResultItem}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Style="{StaticResource LinkButton}" Content="+ Hinzufügen"
                                                Command="{Binding DataContext.AddSymbolCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource LinkButton}" Content="Chart"
                                                Command="{Binding DataContext.OpenSearchResultChartCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Neue Watchlist" Style="{StaticResource SectionTitle}" />
                    <TextBox Text="{Binding NewWatchlistName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name der Watchlist" />
                    <Button Content="Anlegen" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Command="{Binding CreateWatchlistCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
    </Grid>
</UserControl>
