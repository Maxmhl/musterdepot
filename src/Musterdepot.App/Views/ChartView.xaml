<UserControl x:Class="Musterdepot.App.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Musterdepot.App.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChartViewModel}">
    <DockPanel>
        <!-- Werkzeugleiste -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Symbol, TargetNullValue='kein Symbol'}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="{Binding LastPrice}" FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{DynamicResource App.TextSecondary}" />
                <ComboBox ItemsSource="{Binding Timeframes}" SelectedItem="{Binding SelectedTimeframe}" DisplayMemberPath="Label"
                          Width="110" Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="Zeitrahmen" />
                <CheckBox Content="EMA 20" IsChecked="{Binding ShowEmaFast}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <CheckBox Content="EMA 50" IsChecked="{Binding ShowEmaSlow}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <CheckBox Content="VWAP" IsChecked="{Binding ShowVwap}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <CheckBox Content="Bollinger" IsChecked="{Binding ShowBollinger}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <CheckBox Content="RSI 14" IsChecked="{Binding ShowRsi}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <Button Content="Neu laden" Command="{Binding ReloadCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button Content="Handeln" Style="{StaticResource PrimaryButton}" Command="{Binding TradeCommand}" VerticalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="80" Height="3" Margin="12,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource WarningBanner}" Margin="0,0,0,12"
                Visibility="{Binding DelayNotice, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding DelayNotice}" TextWrapping="Wrap" Foreground="{DynamicResource App.Warning}" FontWeight="SemiBold" />
        </Border>

        <!-- Lizenzhinweis: TradingView Lightweight Charts (Apache-2.0) -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}">
                <Run Text="Charts:" />
                <Hyperlink NavigateUri="https://www.tradingview.com/" RequestNavigate="OnRequestNavigate">TradingView Lightweight Charts™</Hyperlink>
                <Run Text="(Apache-2.0) · Indikatoren in Musterdepot berechnet" />
            </TextBlock>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusMessage}" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="WebView" />
                <Border Style="{StaticResource DangerBanner}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                        Visibility="{Binding WebViewError, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="Chart kann nicht angezeigt werden" FontWeight="SemiBold" Foreground="{DynamicResource App.Danger}" />
                        <TextBlock Text="{Binding WebViewError}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                            <Run Text="Die Microsoft Edge WebView2-Laufzeit wird benötigt:" />
                            <Hyperlink NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/" RequestNavigate="OnRequestNavigate">herunterladen</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
