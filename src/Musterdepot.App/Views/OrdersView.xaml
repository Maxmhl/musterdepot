<UserControl x:Class="Musterdepot.App.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Musterdepot.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OrdersViewModel}">
    <UserControl.Resources>
        <!-- Quelle Mensch/KI als kleines Abzeichen -->
        <DataTemplate x:Key="SourceCell">
            <Border x:Name="Bd" Style="{StaticResource NeutralBadge}">
                <TextBlock Text="{Binding Source}" FontSize="11" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAi}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentSoft}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" MinHeight="200" />
            <RowDefinition Height="16" />
            <RowDefinition Height="3*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Offene Orders -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,12,16,4">
                        <Button DockPanel.Dock="Right" Content="Alle stornieren" Command="{Binding CancelAllCommand}" />
                        <TextBlock Text="Offene Orders" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                    </DockPanel>
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding OpenOrders}" SelectedItem="{Binding SelectedOpenOrder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Erstellt" Binding="{Binding Created}" Width="110" />
                            <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="120" FontWeight="SemiBold" />
                            <DataGridTemplateColumn Header="Seite" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:OrderRowViewModel}">
                                        <TextBlock Text="{Binding Side}" Tag="{Binding SideSign}" Style="{StaticResource SignedText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="110" />
                            <DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="90" />
                            <DataGridTextColumn Header="Ausgeführt" Binding="{Binding Filled}" Width="90" />
                            <DataGridTextColumn Header="Limit" Binding="{Binding Limit}" Width="100" />
                            <DataGridTextColumn Header="Stop" Binding="{Binding Stop}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Gültig" Binding="{Binding Tif}" Width="60" />
                            <DataGridTemplateColumn Header="Quelle" Width="120" CellTemplate="{StaticResource SourceCell}" />
                            <DataGridTextColumn Header="Strategie" Binding="{Binding Strategy}" Width="*" />
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:OrderRowViewModel}">
                                        <Button Style="{StaticResource LinkButton}" Content="Stornieren" Foreground="{DynamicResource App.Negative}"
                                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Order ändern -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Order ändern" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Offene Order links auswählen."
                               Visibility="{Binding SelectedOpenOrder, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                        <Run Text="{Binding SelectedOpenOrder.Symbol, Mode=OneWay}" />
                        <Run Text="{Binding SelectedOpenOrder.Side, Mode=OneWay}" />
                        <Run Text="{Binding SelectedOpenOrder.Type, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="Neue Menge" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ModifyQuantity, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Neues Limit" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ModifyLimit, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Neuer Stop" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ModifyStop, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Änderung senden" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Command="{Binding ModifyCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Historie -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,12,16,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Historie" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBox Grid.Column="1" MaxWidth="260" HorizontalAlignment="Left" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="Filter nach Symbol oder Strategie-Tag" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="CSV-Export:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="Ausführungen (Excel DE)" Command="{Binding ExportFillsCommand}" CommandParameter="de" Margin="0,0,6,0"
                                ToolTip="Semikolon, Dezimalkomma, Ortszeit, UTF-8 mit BOM" />
                        <Button Content="Ausführungen (international)" Command="{Binding ExportFillsCommand}" CommandParameter="invariant" Margin="0,0,6,0"
                                ToolTip="Komma, Dezimalpunkt, ISO-8601 in UTC" />
                        <Button Content="Orders (Excel DE)" Command="{Binding ExportOrdersCommand}" CommandParameter="de" Margin="0,0,6,0" />
                        <Button Content="Orders (international)" Command="{Binding ExportOrdersCommand}" CommandParameter="invariant" />
                    </StackPanel>
                </Grid>
                <TabControl Margin="8,4,8,8" BorderThickness="0" Background="Transparent">
                    <TabItem Header="Ausführungen">
                        <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Fills}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="110" />
                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="120" FontWeight="SemiBold" />
                                <DataGridTemplateColumn Header="Seite" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:FillRowViewModel}">
                                            <TextBlock Text="{Binding Side}" Tag="{Binding SideSign}" Style="{StaticResource SignedText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="90" />
                                <DataGridTextColumn Header="Preis" Binding="{Binding Price}" Width="100" />
                                <DataGridTextColumn Header="Gebühr" Binding="{Binding Fee}" Width="90" />
                                <DataGridTemplateColumn Header="Realisiert" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:FillRowViewModel}">
                                            <TextBlock Text="{Binding Realized}" Tag="{Binding RealizedSign}" Style="{StaticResource SignedText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Qualität" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:FillRowViewModel}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Quality}" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource DelayedBadge}" Margin="6,0,0,0"
                                                        ToolTip="Nach Standby/Verbindungsabbruch gegen nachgeladene Kerzen ausgeführt"
                                                        Visibility="{Binding DuringGap, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="während Lücke" Style="{StaticResource DelayedBadgeText}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Liquidität" Binding="{Binding Liquidity}" Width="80" />
                                <DataGridTemplateColumn Header="Quelle" Width="90" CellTemplate="{StaticResource SourceCell}" />
                                <DataGridTextColumn Header="Strategie" Binding="{Binding Strategy}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Alle Orders">
                        <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding OrderHistory}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Erstellt" Binding="{Binding Created}" Width="110" />
                                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="120" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Seite" Binding="{Binding Side}" Width="80" />
                                <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="110" />
                                <DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="90" />
                                <DataGridTextColumn Header="Ausgeführt" Binding="{Binding Filled}" Width="90" />
                                <DataGridTextColumn Header="Ø Preis" Binding="{Binding AveragePrice}" Width="100" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                                <DataGridTemplateColumn Header="Quelle" Width="120" CellTemplate="{StaticResource SourceCell}" />
                                <DataGridTextColumn Header="Strategie" Binding="{Binding Strategy}" Width="120" />
                                <DataGridTextColumn Header="Ablehnungsgrund" Binding="{Binding RejectReason}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />
    </Grid>
</UserControl>
